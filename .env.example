# Financial Modeling Prep API key (required for `npm run scrape`)
FMP_API_KEY=your-fmp-api-key

# Vercel Blob Storage (auto-created when adding Vercel Blob to project)
BLOB_READ_WRITE_TOKEN=vercel_blob_token_here

# Blob URL for fetching company data (set after first scrape run)
# Leave empty to use local data/companies.json file
BLOB_URL=

# Optional: explicit URL of the user-presets blob (derived from BLOB_URL if unset)
PRESETS_BLOB_URL=

# Legacy manual scrape endpoint (/api/scrape) auth token
# Generate with: openssl rand -hex 32
SCRAPER_SECRET=your-secret-token-here
